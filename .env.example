# Copy to .env in the main checkout; existing .env users should add only missing keys.
DAAAM_SRC_DIR=/home/arclunar/jellymap_dev/third_party/src/daaam_ws/src
COMPOSE_PROJECT_NAME=daaam
WORKSPACE_VOLUME=daaam_daaam_workspace
# Existing large datasets may be reused; adapt to your machine.
DAAAM_DATA_DIR=/mnt/e/daaam-data
# JellyMap workspace paths (optional; unset = datasets/, output/, data/ and scripts/{replay_web,gs_world} of this
# repository): prepared TUM datasets (mounted at /datasets), results (mounted at output/ in the container), OC-NavQA
# inputs, and the workspace whose shared replay_web/gs_world implementations are used.
DAAAM_DATASETS_DIR=/home/arclunar/jellymap_dev/data/processed/tum
DAAAM_OUTPUT_DIR=/home/arclunar/jellymap_dev/runs/daaam
DAAAM_NAVQA_DIR=/home/arclunar/jellymap_dev/data/raw/oc_navqa_inputs
JELLYMAP_ROOT=/home/arclunar/jellymap_dev
# Optional download proxy, configured per machine.
HTTPS_PROXY=
