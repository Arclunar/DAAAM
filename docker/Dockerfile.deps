# syntax=docker/dockerfile:1.7
#
# 在开发镜像（docker/Dockerfile → daaam:jazzy-cu128-dev）之上，只追加 rosdep 解析出的
# 系统包（docker/apt-deps.txt）。不包含任何 DAAAM 源码、Python 依赖或编译产物——
# 这些仍然保存在 daaam_workspace 卷里。
#
# 构建：docker compose build daaam-ws
ARG BASE_IMAGE=daaam:jazzy-cu128-dev
FROM ${BASE_IMAGE}

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY docker/apt-deps.txt /tmp/apt-deps.txt

# 与 rosdep 的行为保持一致（默认安装 Recommends），保证与手动 rosdep install 的结果相同。
RUN apt-get update \
    && grep -vE '^[[:space:]]*(#|$)' /tmp/apt-deps.txt \
       | xargs apt-get install -y \
    && rm -rf /var/lib/apt/lists/* /tmp/apt-deps.txt

USER daaam
WORKDIR /opt/daaam_ws/src/daaam
